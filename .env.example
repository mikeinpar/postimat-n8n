# Environment variables these workflows expect.
# Copy the names into your own n8n instance (Settings -> Variables, or the
# environment of the n8n process) and fill in your own values. Nothing here is
# read from this file directly: n8n resolves $env.* at run time.

# Outbound proxy used by the nodes that fetch source pages and call the LLM.
# Include credentials in the URL if your proxy needs them.
# Referenced as {{ $env.PROXY_URL }} in 6 nodes.
PROXY_URL=http://user:password@proxy.example.com:8080

# Telegram chat id the service reports to: the daily digest, error alerts and
# admin notifications all go here. A negative id for a channel or supergroup.
# Referenced as $env.ADMIN_CHAT_ID in 8 places.
ADMIN_CHAT_ID=-1000000000000
