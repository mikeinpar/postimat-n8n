      "name": "DIG: Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  c.id AS channel_id,\n  COALESCE(c.tg_chat_id, c.max_chat_id) AS chat_id,\n  CASE WHEN c.tg_chat_id IS NOT NULL THEN 'TG' ELSE 'MAX' END AS platform,\n  COUNT(CASE WHEN p.status = 'SUCCESS' THEN 1 END) AS success_count,\n  COUNT(CASE WHEN p.status LIKE 'FAILED%' THEN 1 END) AS failed_count,\n  COUNT(CASE WHEN p.status LIKE 'SKIPPED%' THEN 1 END) AS skipped_count\nFROM channels c\nLEFT JOIN posts_queue p\n  ON p.channel_id = c.id\n  AND p.created_at > NOW() - INTERVAL '24 hours'\nWHERE c.is_active = true\nGROUP BY c.id, c.tg_chat_id, c.max_chat_id\nORDER BY c.id",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        208,
        0
      ],
      "id": "95af8379-5cd2-4609-b8b4-0f5bf5791733",
      "name": "DIG: PG Get Stats",
      "credentials": {
        "postgres": {
          "id": "wkLZ9j8s0cYjutRB",
          "name": "content_saas"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst date = new Date().toLocaleDateString('ru-RU', { timeZone: 'Europe/Moscow' });\n\nlet text = `📊 *Дайджест за ${date}*\\n\\n`;\n\nfor (const row of rows) {\n  const r = row.json;\n  const total = (r.success_count || 0) + (r.failed_count || 0) + (r.skipped_count || 0);\n  const status = r.failed_count > 0 ? '⚠️' : '✅';\n  text += `${status} *[${r.platform}]* \\`${r.chat_id}\\`\\n`;\n  text += `  ✅ ${r.success_count}  ❌ ${r.failed_count}  ⏭ ${r.skipped_count}  / всего ${total}\\n\\n`;\n}\n\nif (rows.length === 0) {\n  text += '_Нет активных каналов_';\n}\n\nreturn [{ json: { text } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
