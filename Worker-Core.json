    {
      "parameters": {
        "promptType": "define",
        "text": "=Вот текст, измени его и верни JSON:\n{{ $json.text }}",
        "needsFallback": true,
        "options": {
          "systemMessage": "=Ты — опытный главный редактор Telegram-канала. Твоя цель — сделать глубокий, но бережный рерайт предоставленного текста.\n\nТЕМАТИКА И ГОЛОС КАНАЛА:\n{{ $('WC: Execute Worker-Core').first().json.generation_prompt }}\n\nПРАВИЛА РЕРАЙТА:\n1. Перефразирование: Обязательно измени структуру предложений и используй синонимы. Напиши текст живым языком от лица \"опытного\".\n2. Сохранение фактов: Точно перенеси все цифры, пропорции, термины и названия из исходника.\n3. Оригинальная структура (CRITICAL): Оставь исходный формат подачи (списки, пошаговые инструкции).\n4. Очистка: БЕЗЖАЛОСТНО ВЫРЕЗАЙ любые приветствия (\"Доброе утро\", \"Привет всем\"), упоминания времени суток, упоминания чужих каналов, призывы подписаться и личные местоимения. Начинай текст сразу с сути (с рецепта или факта).\n5. Эмодзи: Расставь 2-3 смысловых эмодзи.\n6. Длина финального заголовка+текста  должна быть строго в пределах 900 символов.\n7. Текст и заголовок должны быть полностью на русском языке.\n\nФормат вывода: Один емкий заголовок, затем пустая строка, затем основной текст (начинай сразу с сути, не дублируя заголовок).\n\nТВОЙ ВЫВОД (СТРОГО JSON):\n{\n\"title\": \"Только заголовок\",\n\"final_text\": \"Основной переписанный текст с сохранением структуры донора\"\n}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        3440,
        368
      ],
      "id": "afee1a62-c450-417f-9f00-8980821afc12",
      "name": "WC: AI Editor",
      "retryOnFail": true,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "try {\n    // 1. Парсим текст и заголовок от Второго ИИ (Твой код)\n    let rawOutput = $json.output || $json.text || \"\";\n    rawOutput = rawOutput.replace(/```json/gi, '').replace(/```/gi, '').trim();\n\n    const jsonMatch = rawOutput.match(/\\{[\\s\\S]*\\}/);\n    if (!jsonMatch) throw new Error(\"JSON не найден в ответе ИИ-редактора\");\n    \n    let jsonString = jsonMatch[0];\n    let cleanJson = '';\n    let inString = false;\n    let escapeNext = false;\n\n    for (let i = 0; i < jsonString.length; i++) {\n        let char = jsonString[i];\n        if (escapeNext) { cleanJson += char; escapeNext = false; continue; }\n        if (char === '\\\\') { cleanJson += char; escapeNext = true; continue; }\n        if (char === '\"') { inString = !inString; cleanJson += char; continue; }\n        \n        if (inString && char === '\\n') { cleanJson += '\\\\n'; continue; }\n        if (inString && char === '\\r') { cleanJson += '\\\\r'; continue; }\n        if (inString && char === '\\t') { cleanJson += '\\\\t'; continue; }\n        cleanJson += char;\n    }\n\n    const data = JSON.parse(cleanJson);\n\n    // 2. МАГИЯ: Подтягиваем оригинальные ссылки из прошлой ноды!\n    // ВПИШИ СЮДА ИМЯ НОДЫ ИЗ ШАГА 1\n    const metaData = $('WC: Limit 1').all()[0].json;\n\n    // 3. Формируем финальный идеальный пакет для отправки в Telegram\n    return {\n        final_text: data.final_text || \"Текст не найден\",\n        title: data.title || \"\",\n        selected_post_id: metaData.post_id,\n        source_id:   metaData.source_id,\n        channel: metaData.channel,\n        image_url: metaData.image || metaData.image_url || \"\",\n        video_url: metaData.video || metaData.video_url || \"\",\n        channel_id:  $('WC: Execute Worker-Core').all()[0].json.id,\n        tg_chat_id:  $('WC: Execute Worker-Core').all()[0].json.tg_chat_id || null,\n        max_chat_id: $('WC: Execute Worker-Core').all()[0].json.max_chat_id || null,\n        source_url:   'https://t.me/s/' + metaData.channel,\n    };\n\n} catch (error) {\n    throw new Error(\"Ошибка сборки финального поста: \" + error.message);\n}"
      },
