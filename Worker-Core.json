      "id": "d0c1897b-51a8-4b9b-aaaa-98ffe83ae636",
      "name": "WC: Dedup Filter"
    },
    {
      "parameters": {
        "jsCode": "const MIN_LENGTH = 100; \n\nlet processedPosts = [];\n\nconst rawChatId = $('WC: PG Get Sources').first().json.source_url.split('/s/')[1] || '';\nconst ownChannel = rawChatId.replace('@', '').toLowerCase();\n\n// Белый список:\nconst allowedDomains = [\n    ownChannel,       // собственный канал\n    'telegra.ph',     // Telegraph — платформа Telegram\n    't.me/iv',        // Instant View ссылки\n];\n\nfor (const item of $input.all()) {\n    const json = item.json;\n    const html = json.posts || \"\";\n    const reactions = Number(json.reactions) || 0;\n    const views = Number(json.views) || 0;\n    \n    // 1. Изолируем только блок с текстом поста (игнорируем аватарки и кнопки)\n    const textBlockMatch = html.match(/class=\"tgme_widget_message_text[^>]*>([\\s\\S]*?)<\\/div>/);\n    const postTextHtml = textBlockMatch ? textBlockMatch[1] : \"\";\n    \n    // 2. Очищаем текст для проверки длины и передачи нейросети\n    let tempText = postTextHtml.replace(/<br\\s*\\/?>/gi, '\\n');\n    const betatextClean = tempText.replace(/<[^>]*>/g, '').trim();\n\n   // 3. Фильтры мусора и поиск видео\nconst isForwarded = html.includes('tgme_widget_message_forwarded_from'); \nconst isRoundVideo = html.includes('round_video'); // Ищем маркер \"кружочка\"\nconst adKeywords = ['erid:', '#реклама', 'заказать по ссылке'];\nconst hasAdKeywords = adKeywords.some(word => postTextHtml.toLowerCase().includes(word));\nconst isPoll = html.includes('tgme_widget_message_poll');\nconst isMediaTooBig = html.includes('Media is too big');\nconst isTooShort = betatextClean.length < MIN_LENGTH;\n  \n    const linksMatch = postTextHtml.match(/href=\"([^\"]*)\"/g) || [];\n    let hasForeignLink = false;\n\n    for (let link of linksMatch) {\n        let url = link.replace('href=\"', '').replace('\"', '');\n        // Если ссылка ведет наружу (http) и ее нет в белом списке - это чужая реклама\n        if (url.startsWith('http') && !allowedDomains.some(domain => url.includes(domain))) {\n            hasForeignLink = true; // Нашли чужую ссылку — прерываем цикл проверки ссылок\n            break;\n        }\n    }\n\n// Блокируем кружочки, но пропускаем обычные видео!\nif (isForwarded || isRoundVideo || isPoll || isTooShort || hasAdKeywords || isMediaTooBig || !betatextClean) continue;\n\n\n  // ФИНАЛЬНАЯ ОЧИСТКА ХВОСТОВ (с сохранением абзацев)\n  let textClean = betatextClean\n    // вырезаем все \"голые\" ссылки вида https://...\n    .replace(/https?:\\/\\/[^\\s]+/gi, '')\n    // Отрезаем всё от стоп-слова до конца строки (.* означает \"любые символы до конца строки\")\n    .replace(/(Подписывайтесь|Подписывайся) на .*/gi, '')\n    .replace(/(Следите|Читай) за новостями .*/gi, '')\n    .replace(/(Наш|Мой) канал:? .*/gi, '')\n    \n    // Добавляем специфичный мусор из твоих постов-доноров:\n    .replace(/(Больше советов тут|Читайте далее) .*/gi, '')\n    .replace(/Мы в MAX.*/gi, '')\n    .replace(/читать полностью.*/gi, '')\n    \n    // Убираем двойные/тройные пробелы внутри строк (но не трогаем \\n)\n    .replace(/[ \\t]{2,}/g, ' ')\n    // Схлопываем 3 и более пустых строки в аккуратные двойные отступы\n    .replace(/\\n{3,}/g, '\\n\\n')\n    .trim();\n\n    // 4. Безопасный расчет ERR\n    const err = (views > 0) ? (reactions / views) * 100 : 0;\n\n    processedPosts.push({\n        json: {\n            ...json,\n            err: err,\n            text_clean: textClean, // Передаем чистый текст для ИИ\n            has_foreign_link: hasForeignLink  // AI сам решит\n        }\n    });\n}\n\nreturn processedPosts;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1728,
        368
      ],
      "id": "c7ed717c-01b0-4b85-8d09-dde35bde2508",
      "name": "WC: Filter + ERR"
    },
    {
      "parameters": {
        "jsCode": "const TOP_COUNT = 10;    \n\nconst items = $input.all();\n\n// 1. Сортируем по ERR (от большего к меньшему)\nconst sorted = items.sort((a, b) => b.json.err - a.json.err);\n\n// 2. Формируем ОТДЕЛЬНЫЕ элементы для каждого кандидата\nconst topCandidates = sorted.slice(0, TOP_COUNT).map(item => {\n    return {\n        json: {\n            post_id: item.json.post_id,\n            text: item.json.text_clean,\n            image: item.json.image_url,\n            video: item.json.video_url,\n            channel: item.json.channel_name,\n            err: item.json.err,\n            source_id: item.json.source_id\n        }\n    };\n});\n\n// 3. Возвращаем массив элементов. n8n воспримет их как 10 отдельных потоков данных!\nreturn topCandidates;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1888,
        368
      ],
      "id": "4fdde2d5-d5a6-4a8f-9264-cd0c97d7cfb2",
      "name": "WC: Top-10 ERR"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Вот пост для анализа. Оцени и верни JSON:\n{{ $json.text }}\n",
        "needsFallback": true,
        "options": {
          "systemMessage": "=Ты — безжалостный модератор Telegram-канала.\nЯ дам тебе текст поста. Твоя задача найти в нем маскированную рекламу, инфоцыганство или байт.\n\nБЛОКИРУЙ ПОСТ (ставь is_approved: false), если есть:\n1. Заработок, деньги, пособия: \"как я заработала\", \"выплаты от государства\", \"декретные\".\n2. Услуги и курсы: реклама юристов, врачей, астрологов, фитнес-тренеров, гайды, чеклисты.\n3. Личные драмы (прогревы): истории про развод, плохую свекровь, проблемы с мужем/детьми.\n4. Кликбейт: математические задачки (\"решит не каждый\"), тесты на IQ, призывы \"смотреть ответ в источнике\".\n5. Любые товары с подозрительным описанием (явно рекламным языком).\n6. Пустые пожелания (Тайминг): посты, состоящие ТОЛЬКО из пожеланий \"доброго утра\", \"спокойной ночи\", \"как спалось\", \"хорошего дня\". (Если в посте есть полноценный полезный рецепт, НЕ БЛОКИРУЙ его из-за одного слова \"утро\").\n\nПРОПУСКАЙ ПОСТ (ставь is_approved: true), если это:\n{{ $('WC: Execute Worker-Core').first().json.filter_prompt }}\n\nЕсли has_foreign_link = true — проверь контекст ссылки. \nРеклама товара/услуги → is_approved: false. \nСсылка на статью/источник данных → оставляй.\n\nВЕРНИ СТРОГО JSON:\n{\n  \"reason\": \"Кратко объясни, есть ли тут маркеры рекламы\",\n  \"is_approved\": true или false\n}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        2288,
        368
      ],
      "id": "3221db64-90f2-48ea-a247-f8705d6b3828",
      "name": "WC: AI Censor",
      "retryOnFail": true,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "try {\n  // 1. Ищем ответ ИИ-Привратника\n  let rawText = $input.item.json.output || $input.item.json.text || $input.item.json.message?.content || \"\";\n  \n  // 2. Очищаем от мусора и парсим\n  let cleanJsonStr = rawText.replace(/```json/gi, '').replace(/```/gi, '').trim();\n  let parsed = JSON.parse(cleanJsonStr);\n\n  // 3. МАГИЯ N8N: Достаем оригинальный пост из ноды ДО нейросети!\n  // $('ИМЯ_НОДЫ').item.json берет ровно тот пост, который сейчас проверялся\n  let originalPost = $('WC: Top-10 ERR').item.json;\n\n  // 4. Склеиваем всё вместе\n  return {\n    json: {\n      ...originalPost, // Возвращаем на место post_id, text_clean, image_url и т.д.\n      is_approved: parsed.is_approved,\n      reason: parsed.reason // Оставляем причину на случай, если захочешь проверить логику ИИ\n    }\n  };\n} catch (e) {\n  // Предохранитель, если ИИ выдал бред\n  let originalPost = $('WC: Top-10 ERR').item.json;\n  return {\n    json: {\n      ...originalPost,\n      is_approved: false,\n      reason: \"Ошибка парсинга ответа ИИ: \" + e.message\n    }\n  };\n}"
      },
