      "parameters": {
        "jsCode": "// Переименовываем файл изображения в короткое имя.\n// URL cdn4.telesco.pe содержит огромный токен → ENAMETOOLONG в MAX-ноде.\nconst item = $input.all()[0];\nif (item.binary && item.binary.data_image) {\n    item.binary.data_image.fileName = 'image.jpg';\n    item.binary.data_image.mimeType = item.binary.data_image.mimeType || 'image/jpeg';\n}\nreturn [item];"
